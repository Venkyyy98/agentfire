AGENT_MODE=fallback
AGENTFIRE_LLM_MODEL=gpt-4o-mini
# Required only when AGENT_MODE=llm. Never commit a real value.
OPENAI_API_KEY=

EVENT_BACKEND=local
# Recommended sponsor backend: set EVENT_BACKEND=rawtree.
RAWTREE_URL=https://api.rawtree.com
RAWTREE_API_KEY=
RAWTREE_DATABASE=default
RAWTREE_EVENTS_TABLE=agentfire_events
RAWTREE_MEMORIES_TABLE=agentfire_memories

# Standard Tinybird Events API fallback: set EVENT_BACKEND=tinybird.
TINYBIRD_HOST=https://api.tinybird.co
TINYBIRD_TOKEN=
TINYBIRD_EVENTS_DATASOURCE=agentfire_events
TINYBIRD_MEMORIES_DATASOURCE=agentfire_memories

# Phase 3 experience compiler: OpenRouter must execute an actual liquid/... model.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LIQUID_MODEL=liquid/lfm-2.5-2.6b:free

NIMBLE_API_KEY=
NIMBLE_API_URL=https://sdk.nimbleway.com/v2/search

# Phase 5 scenario intelligence. Obtain a key from https://online.nimbleway.com.
NIMBLE_API_KEY=
NIMBLE_API_URL=https://sdk.nimbleway.com/v2/search
